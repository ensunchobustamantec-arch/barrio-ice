rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Todos pueden VER el menú; solo el dueño puede cambiarlo.
    match /tienda/menu {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'PEGA_AQUI_EL_UID_DEL_DUENO';
    }
  }
}
