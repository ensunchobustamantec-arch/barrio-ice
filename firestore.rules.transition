rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null &&
        request.auth.uid == 'NDdEIdTQiqMS947ENRr7aEq1i6B3';
    }
    function signedIn() { return request.auth != null; }
    function staffPath(uid) { return /databases/$(database)/documents/staff/$(uid); }
    function isStaff() {
      return signedIn() && exists(staffPath(request.auth.uid)) &&
        get(staffPath(request.auth.uid)).data.activo == true &&
        get(staffPath(request.auth.uid)).data.rol == 'empleado';
    }
    function isTeam() { return isOwner() || isStaff(); }
    function bogotaDate() {
      let local = request.time - duration.value(5, 'h');
      return string(local.year()) + '-' +
        (local.month() < 10 ? '0' + string(local.month()) : string(local.month())) + '-' +
        (local.day() < 10 ? '0' + string(local.day()) : string(local.day()));
    }

    match /tienda/menu {
      allow read: if true;
      allow write: if isOwner();
    }
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list, create, update, delete: if isOwner();
    }

    // PII privada: nombre completo, celular y dirección solo para el dueño.
    match /pedidos/{pedidoId} {
      allow create: if validNewOrder(pedidoId);
      allow get, list, update, delete: if isOwner();
    }

    // Seguimiento público: solo estado y datos mínimos, solo lectura por ID.
    match /seguimiento/{pedidoId} {
      allow get: if true;
      allow create: if isOwner() || validNewTracking(pedidoId);
      allow update: if isOwner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'actualizadoEn'
        ]);
      allow delete: if isOwner();
    }
    match /ventas_local/{id} {
      allow create: if isTeam() && validSale(id);
      allow get, list: if isOwner() ||
        (isStaff() && resource.data.empleadoUid == request.auth.uid);
      allow update: if isTeam() && canVoidSale();
      allow delete: if false;
    }
    match /cierres/{id} {
      allow create: if isTeam() && validClosing(id);
      allow get, list: if isOwner();
      allow update, delete: if false;
    }
    match /auditoria/{id} {
      allow create: if isTeam() && validAudit(id);
      allow get, list: if isOwner();
      allow update, delete: if false;
    }

    function validNewTracking(id) {
      let d = request.resource.data;
      let p = getAfter(/databases/$(database)/documents/pedidos/$(id)).data;
      return d.keys().hasOnly([
          'estado', 'tipo', 'fecha', 'creadoEn', 'nombreCorto'
        ]) &&
        d.keys().hasAll([
          'estado', 'tipo', 'fecha', 'creadoEn', 'nombreCorto'
        ]) &&
        existsAfter(/databases/$(database)/documents/pedidos/$(id)) &&
        d.estado == 'Nuevo' &&
        d.tipo == p.entrega.tipo &&
        d.fecha == p.fecha &&
        d.creadoEn == request.time &&
        d.creadoEn == p.creadoEn &&
        d.nombreCorto is string &&
        d.nombreCorto.size() >= 1 &&
        d.nombreCorto.size() <= 20;
    }

    function validNewOrder(id) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'items', 'cliente', 'entrega', 'pago', 'conCuanto', 'notas',
          'subtotal', 'descuento', 'domicilio', 'total', 'promo',
          'promoBuy', 'promoReceive', 'mayor18', 'tieneLicor',
          'estado', 'fecha', 'creadoEn'
        ]) &&
        d.keys().hasAll([
          'items', 'cliente', 'entrega', 'pago', 'subtotal', 'descuento',
          'domicilio', 'total', 'promo',
          'estado', 'fecha', 'creadoEn'
        ]) &&
        d.items is list &&
        d.items.size() > 0 &&
        d.items.size() <= 60 &&
        d.cliente is map &&
        d.cliente.keys().hasOnly(['nombre', 'celular']) &&
        d.cliente.nombre is string &&
        d.cliente.nombre.size() >= 1 &&
        d.cliente.nombre.size() <= 60 &&
        d.cliente.celular is string &&
        d.cliente.celular.matches('^[0-9+() -]{10,18}$') &&
        d.entrega is map &&
        d.entrega.keys().hasOnly(['tipo', 'direccion', 'referencia']) &&
        d.entrega.tipo in ['domicilio', 'recoger'] &&
        d.entrega.direccion is string &&
        d.entrega.direccion.size() <= 140 &&
        d.entrega.referencia is string &&
        d.entrega.referencia.size() <= 140 &&
        d.pago in ['Efectivo', 'Nequi', 'Llaves Bre-B', 'Bancolombia', 'Daviplata'] &&
        d.conCuanto is number &&
        d.conCuanto >= 0 &&
        d.conCuanto <= 5000000 &&
        d.notas is string &&
        d.notas.size() <= 300 &&
        d.subtotal is number &&
        d.subtotal >= 0 &&
        d.subtotal <= 2000000 &&
        d.descuento is number &&
        d.descuento >= 0 &&
        d.descuento * 2 <= d.subtotal &&
        d.total is number &&
        d.total >= 0 &&
        d.total <= 2000000 &&
        d.subtotal == d.total + d.descuento &&
        d.domicilio == 0 &&
        d.promo is string &&
        d.promo.size() <= 80 &&
        (!d.keys().hasAny(['promoBuy']) ||
          (d.promoBuy is int && d.promoBuy >= 0 && d.promoBuy <= 3)) &&
        (!d.keys().hasAny(['promoReceive']) ||
          (d.promoReceive is int && d.promoReceive >= 0 && d.promoReceive <= 3)) &&
        (!d.keys().hasAny(['mayor18']) || d.mayor18 is bool) &&
        (!d.keys().hasAny(['tieneLicor']) || d.tieneLicor is bool) &&
        (!d.keys().hasAny(['tieneLicor']) || d.tieneLicor == false ||
          (d.keys().hasAny(['mayor18']) && d.mayor18 == true)) &&
        d.estado == 'Nuevo' &&
        d.fecha is string &&
        d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.creadoEn is timestamp;
    }
    function validSale(id) {
      let d = request.resource.data;
      return id.size() >= 20 &&
        d.keys().hasOnly([
          'items', 'subtotal', 'descuento', 'ajuste', 'total', 'promo',
          'metodoPago', 'mayor18', 'tieneLicor', 'fecha', 'creadoEn',
          'empleadoUid', 'empleadoNombre', 'canal', 'anulada',
          'anuladaMotivo', 'anuladaPor', 'anuladaEn', 'ajusteMotivo'
        ]) &&
        d.keys().hasAll([
          'items', 'subtotal', 'descuento', 'ajuste', 'total', 'promo',
          'metodoPago', 'mayor18', 'tieneLicor', 'fecha', 'creadoEn',
          'empleadoUid', 'empleadoNombre', 'canal', 'anulada',
          'anuladaMotivo', 'anuladaPor', 'anuladaEn', 'ajusteMotivo'
        ]) &&
        d.items is list && d.items.size() > 0 && d.items.size() <= 60 &&
        d.subtotal is int && d.subtotal >= 0 && d.subtotal <= 2000000 &&
        d.descuento is int && d.descuento >= 0 && d.descuento <= d.subtotal &&
        d.ajuste is int && d.ajuste >= 0 && d.ajuste * 2 <= d.subtotal &&
        d.total is int && d.total >= 1000 && d.total <= 2000000 &&
        d.total == d.subtotal - d.descuento - d.ajuste &&
        (d.ajuste == 0 || (d.ajusteMotivo is string && d.ajusteMotivo.size() >= 5)) &&
        d.promo is string && d.promo.size() <= 80 &&
        d.metodoPago in ['Efectivo', 'Nequi', 'Llaves Bre-B', 'Bancolombia', 'Otro'] &&
        d.mayor18 is bool && d.tieneLicor is bool &&
        (!d.tieneLicor || d.mayor18 == true) &&
        d.fecha == bogotaDate() && d.creadoEn == request.time &&
        d.empleadoUid == request.auth.uid && d.empleadoNombre is string &&
        d.empleadoNombre.size() >= 1 && d.empleadoNombre.size() <= 60 &&
        d.canal == 'mostrador' && d.anulada == false &&
        d.anuladaMotivo == '' && d.anuladaPor == '' && d.anuladaEn == null &&
        d.ajusteMotivo is string && d.ajusteMotivo.size() <= 160;
    }
    function canVoidSale() {
      let d = request.resource.data;
      return resource.data.anulada == false && d.anulada == true &&
        d.anuladaMotivo is string && d.anuladaMotivo.size() >= 5 &&
        d.anuladaMotivo.size() <= 160 && d.anuladaPor == request.auth.uid &&
        d.anuladaEn == request.time &&
        d.diff(resource.data).affectedKeys().hasOnly([
          'anulada', 'anuladaMotivo', 'anuladaPor', 'anuladaEn'
        ]) &&
        (isOwner() || (
          resource.data.empleadoUid == request.auth.uid &&
          request.time - resource.data.creadoEn <= duration.value(2, 'm')
        ));
    }
    function validClosing(id) {
      let d = request.resource.data;
      return id.size() >= 20 &&
        d.keys().hasOnly([
          'fecha', 'creadoEn', 'empleadoUid', 'empleadoNombre',
          'efectivoEsperado', 'efectivoContado', 'diferencia', 'notas'
        ]) &&
        d.keys().hasAll([
          'fecha', 'creadoEn', 'empleadoUid', 'empleadoNombre',
          'efectivoEsperado', 'efectivoContado', 'diferencia', 'notas'
        ]) &&
        d.fecha == bogotaDate() && d.creadoEn == request.time &&
        d.empleadoUid == request.auth.uid && d.empleadoNombre is string &&
        d.efectivoEsperado is int && d.efectivoEsperado >= 0 &&
        d.efectivoContado is int && d.efectivoContado >= 0 &&
        d.diferencia == d.efectivoContado - d.efectivoEsperado &&
        d.notas is string && d.notas.size() <= 300;
    }
    function validAudit(id) {
      let d = request.resource.data;
      return id.size() >= 20 &&
        d.keys().hasOnly(['tipo', 'ventaId', 'creadoEn', 'actorUid', 'detalle']) &&
        d.keys().hasAll(['tipo', 'ventaId', 'creadoEn', 'actorUid', 'detalle']) &&
        d.tipo == 'anulacion' && d.ventaId is string && d.ventaId.size() >= 20 &&
        d.creadoEn == request.time && d.actorUid == request.auth.uid &&
        d.detalle is string && d.detalle.size() >= 5 && d.detalle.size() <= 160;
    }
  }
}
